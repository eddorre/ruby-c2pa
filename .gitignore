# Bundler — local gem installation path and config
vendor/bundle/
.bundle/

# Gemfile.lock is committed for apps, but not for gems
# (dependents should resolve their own versions)
Gemfile.lock

# Rust build artifacts
ext/c2pa_native/target/
/target/

# Compiled native extension
lib/c2pa/c2pa_native.bundle
lib/c2pa/c2pa_native.so
lib/c2pa/c2pa_native.dll
# Per-Ruby-version extensions from cross-compiling
lib/c2pa/[0-9]*/

# Gems built by `rake native gem` and the release workflow
pkg/

# rake-compiler temp directory
tmp/

# Signing certificates fetched by `rake fixtures:certs`. These are the public
# c2pa-rs development fixtures rather than secrets, but a PEM private key in a
# content-authenticity repository invites confusion and secret-scanning alerts.
test/fixtures/certs/

# Built gem packages
*.gem

# macOS
.DS_Store
